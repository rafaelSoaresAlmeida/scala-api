# UserController
POST    /users                  controllers.UserController.addUser()
GET     /users                  controllers.UserController.getAll()
GET     /users/name/:name       controllers.UserController.getByName(name: String)
DELETE  /users/:id              controllers.UserController.deleteUser(id: Long)