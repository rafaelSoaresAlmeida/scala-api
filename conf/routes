# Routes
# This file defines all application routes (Higher priority routes first)
# https://www.playframework.com/documentation/latest/ScalaRouting
# ~~~~

# UserController
POST     /api/users                  controllers.UserController.addUser()
GET      /api/users                  controllers.UserController.getAll()
GET      /api/users/name/:name       controllers.UserController.getByName(name: String)
DELETE   /api/users/:id              controllers.UserController.deleteUser(id: Long)

# AuthController
POST    /api/login      controllers.AuthController.login()